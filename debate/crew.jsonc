{
  "tasks": [
    {
      // Supporting side
      "name": "propose",

      "description": "The motion is: {motion}. Present a clear, concise, and convincing argument supporting the motion.",

      "expected_output": "A persuasive argument supporting the motion in a concise format.",

      "agent": "debater",

      "output_file": "output/propose.md",
    },

    {
      // Opposing side
      "name": "oppose",

      "description": "The motion is: {motion}. Present a clear, concise, and convincing argument opposing the motion.",

      "expected_output": "A persuasive argument opposing the motion in a concise format.",

      "agent": "debater",

      "output_file": "output/oppose.md",
    },

    {
      // Judge's verdict
      "name": "decide",

      "description": "Review the supporting and opposing arguments for the motion: {motion}. Decide which side presented the stronger case and explain your reasoning objectively.",

      "expected_output": "A final verdict identifying the winning side with a concise explanation based only on the arguments presented.",

      "agent": "judge",

      "context": ["propose", "oppose"],

      "output_file": "output/verdict.md",
    },
  ],
}
